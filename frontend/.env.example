# The API runs as a Netlify Function on the same site, reachable at /api, so
# there is normally nothing to set here — src/api.js already defaults to "/api"
# and `netlify dev` serves the function alongside Vite on one origin.
#
# Set this ONLY to point a local frontend at an API hosted somewhere else.
# Leaving a localhost value in here is what broke the deployed site before:
# Vite inlines the variable at build time, so the published bundle told every
# visitor's browser to call their own machine.
#
# VITE_API_BASE_URL=http://localhost:8888/api
